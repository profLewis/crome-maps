<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.cromemaps.updater</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Users/plewis/anaconda3/bin/python3</string>
        <string>/Users/plewis/Documents/GitHub/crome-maps/update_datasets.py</string>
        <string>--discover</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/plewis</string>
    </dict>

    <!-- Run every Monday at 06:00; launchd catches up missed runs on wake/login -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>6</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/plewis/Documents/GitHub/crome-maps/updates/launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/plewis/Documents/GitHub/crome-maps/updates/launchd-error.log</string>
</dict>
</plist>
